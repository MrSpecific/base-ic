{
  "name": "@wlcr/base-ic",
  "version": "2.2.2",
  "description": "An opinionated UI system leveraging Base-UI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrSpecific/base-ic.git"
  },
  "homepage": "https://base-ic.vercel.app",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Will Christenson",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "dist/style.css",
    "dist/tokens/**/*.css"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./dist/style.css",
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "default": "./dist/tokens/index.css"
    },
    "./tokens/*": "./dist/tokens/*"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "documentation": "vite serve documentation --config documentation/vite.config.ts",
    "documentation:build": "vite build --config documentation/vite.config.ts",
    "test": "vitest run",
    "typecheck": "node node_modules/typescript/bin/tsc -p . && node node_modules/typescript/bin/tsc -p documentation"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.9.0",
    "react": "^17 || ^18 || ^19",
    "react-dom": "^17 || ^18 || ^19"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true
  }
}
